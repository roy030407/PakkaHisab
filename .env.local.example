# PakkaHisab — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# Keys marked "server only" must NEVER be prefixed with NEXT_PUBLIC_.

# Supabase — get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server only

# Google Gemini — get from: https://aistudio.google.com/apikey (free, no credit card)
GOOGLE_AI_API_KEY=AIza...                              # server only

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — get from Supabase dashboard → Connect button
# DATABASE_URL uses the transaction pooler (port 6543) — for runtime queries
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL uses the session pooler (port 5432) — for Prisma migrations
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Rate limiting — Upstash Redis (optional; rate limits are disabled if not set)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token          # server only

# Cron job protection — generate a random secret and add to Vercel env vars
# Used as: Authorization: Bearer <CRON_SECRET> in the cron requests
CRON_SECRET=your-random-cron-secret                  # server only
